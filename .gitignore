# Build output (only NSIS installer template is tracked)
build/*
!build/windows/
build/windows/*
!build/windows/installer/
build/windows/installer/*
!build/windows/installer/project.nsi
!build/windows/icon.ico
!build/appicon.png
!build/appicon_tray.png
!build/appicon_tray_template.png
# Icon source + generator (see build/icon-src/build_icons.py)
!build/icon-src/
# Release signing public key (RELEASES.md); the private key never lives here
!build/release-pubkey.txt
!build/linux/
# Wails v3 task-driven build config (must be tracked so `wails3 build` works)
!build/Taskfile.yml
!build/config.yml
!build/linux/
!build/windows/Taskfile.yml
!build/darwin/
build/darwin/*
!build/darwin/Taskfile.yml
!build/darwin/Info.plist
!build/darwin/Info.dev.plist
# icns ships prebuilt so `wails dev`/`run` show the real icon before generate:icns ever runs
!build/darwin/icons.icns
uniTerm.exe
FlexTerm.exe
__debug*

# Build output (Wails v3 emits the compiled app + runtime data into bin/)
bin/
dist/

# Wails v3 generated bindings + task runner cache
frontend/bindings/
.task/

# Wails v3 generated Linux packaging metadata (regenerated by `update build-assets`)
build/linux/desktop
build/linux/nfpm/

# Dependencies
node_modules/

# Logs
*.log

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Environment
.env
.env.local

# Go build artifacts
*.exe~
# bare `go build .` output (the wails3 pipeline builds into bin/)
/uniTerm
/FlexTerm
*.test

# Development plugins (VcXsrv)
plugins/
build/windows/installer/plugins/

# Claude Code
.claude/
CLAUDE.md
.superpowers/
docs/superpowers/

# Root package files (project uses frontend/ for Node.js)
/package.json
/package-lock.json
designs/
/design.md
docs/articles/
